# CivicSync environment configuration.
# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development

# Optional: GEMINI_API_KEY=your-gemini-api-key

# Authority Portal (Milestone 16-A) — a single demo authority account.
# AUTHORITY_PASSWORD_HASH must be a hash, never a plaintext password.
# Generate one with:
#   python3 -c "from backend.auth import hash_password; print(hash_password('your-password'))"
AUTHORITY_USERNAME=authority
AUTHORITY_PASSWORD_HASH=

# A long random string signing authority session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
