# CivicSync environment configuration.
# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development

# Optional: GEMINI_API_KEY=your-gemini-api-key

# Optional: a second Gemini API key used only as automatic failover when
# the primary key hits a retryable failure (rate limiting or a temporary
# service outage). If unset, CivicSync behaves exactly as with a single
# key -- no failover, same as before this was added.
# GEMINI_API_KEY_BACKUP=your-backup-gemini-api-key

# Authority Portal (Milestone 16-A) — a single demo authority account.
# AUTHORITY_PASSWORD_HASH must be a hash, never a plaintext password.
# Generate one with:
#   python3 -c "from backend.auth import hash_password; print(hash_password('your-password'))"
AUTHORITY_USERNAME=authority
AUTHORITY_PASSWORD_HASH=

# A long random string signing authority session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Milestone 17: the jurisdiction every newly-submitted issue is scoped to
# (temporary MVP default -- no per-citizen geographic resolution yet).
# Must match a real, active jurisdiction code (see /api/jurisdictions).
CIVICSYNC_DEFAULT_JURISDICTION_CODE=IN-WB-NADIA-KRISHNANAGAR
